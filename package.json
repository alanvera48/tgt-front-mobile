{
  "name": "thegoodtrainer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "setLocal": "ENVFILE=.env",
    "setDev": "ENVFILE=.env.development",
    "setProduction": "ENVFILE=.env.production",
    "ios-dev": "ENVFILE=.env.development react-native run-ios --mode=Debug --scheme TGTDev --simulator \"iPhone 15\"",
    "ios-dev-local": "react-native run-ios --mode=Debug --scheme thegoodtrainer --simulator \"iPhone 15\"",
    "ios-production": "ENVFILE=.env.production react-native run-ios --mode=Debug --scheme TGTDevProd --simulator \"iPhone 15\"",
    "android-dev": "ENVFILE=.env.development react-native run-android",
    "android-production": "ENVFILE=.env.production react-native run-android",
    "android-dev-local": "ENVFILE=.env react-native run-android",
    "build-prod-apk": "cd android && ENVFILE=.env.production ./gradlew assembleRelease",
    "build-dev-apk": "cd android && ENVFILE=.env.development ./gradlew assembleRelease",
    "run-dev": "npm run setLocal react-native start",
    "version": "npx react-native-version --never-amend"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-native-fontawesome": "^0.3.0",
    "@gluestack-style/react": "^1.0.48",
    "@gluestack-ui/config": "^1.1.12",
    "@gluestack-ui/icon": "^0.1.26",
    "@gluestack-ui/themed": "^1.1.9",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^1.22.3",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-picker/picker": "^2.7.5",
    "@react-navigation/bottom-tabs": "^6.5.10",
    "@react-navigation/drawer": "^6.6.7",
    "@react-navigation/native": "^6.1.8",
    "@react-navigation/native-stack": "^6.9.14",
    "@react-navigation/stack": "^6.3.18",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.5.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "formik": "^2.4.5",
    "lodash": "^4.17.21",
    "lottie-react-native": "^7.1.0",
    "moment": "^2.30.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "react-native": "^0.72.6",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-calendars": "^1.1305.0",
    "react-native-config": "^1.5.1",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-get-location": "^4.0.1",
