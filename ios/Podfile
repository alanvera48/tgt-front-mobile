# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '13.4'
prepare_react_native_project!

# Requerido por @react-native-google-signin/google-signin: sus pods de Swift
# (GoogleSignIn, GoogleUtilities) necesitan module maps para integrarse
# como static library cuando no se usa use_frameworks!.
use_modular_headers!

# GoogleSignIn 9.x (vía AppCheckCore ~> 11.0) fuerza GoogleUtilities ~> 8.0,
# incompatible con la versión de Firebase que trae @react-native-firebase por
# default (10.20.0, que pide GoogleUtilities ~> 7.8). Se fija una versión de
# Firebase que ya usa GoogleUtilities 8.x para que ambos pods convivan.
$FirebaseSDKVersion = '11.2.0'

pod 'react-native-video', :path => '../node_modules/react-native-video/react-native-video.podspec'

rn_maps_path = '../node_modules/react-native-maps'
pod 'react-native-google-maps', :path => rn_maps_path

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'thegoodtrainer' do
  config = use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => config[:reactNativePath],
    # Hermes is now enabled by default. Disable by setting this flag to false.
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'thegoodtrainerTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    __apply_Xcode_12_5_M1_post_install_workaround(installer)

    # Xcode 16+/26 trata como error el literal operator con espacio
    # (`operator "" _pt`) de Yoga/Folly/fmt. c++17 solo no alcanza: hay que
    # silenciar ese warning-as-error en todos los pods C++.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        build_configuration.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        build_configuration.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

        flags = build_configuration.build_settings['OTHER_CPLUSPLUSFLAGS']
        flags = ['$(inherited)'] if flags.nil?
        flags = flags.split(' ') if flags.is_a?(String)
        %w[
          -Wno-deprecated-literal-operator
          -Wno-error=deprecated-literal-operator
        ].each do |flag|
          flags << flag unless flags.include?(flag)
        end
        build_configuration.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags

        # El Xcode instalado ya no soporta un deployment target menor a 12.0;
        # algunos pods viejos (ej. RNVectorIcons) todavía piden 11.0.
        deployment_target =
          build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target && deployment_target.to_f < 12.0
          build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end
        build_configuration.build_settings['ENABLE_DEBUG_DYLIB'] = 'NO'
      end

      # use_modular_headers! duplica React-Core (React-Core-60309c9c). El
      # resource bundle extra choca en Archive ("Multiple commands produce").
      if target.name == 'React-Core-60309c9c-AccessibilityResources'
        target.remove_from_project
      end
    end

    # Hermes 0.72 se distribuye con bitcode; App Store Connect lo rechaza.
    system('bash', File.join(__dir__, 'scripts/strip-hermes-bitcode.sh'))

    # El resource script sigue apuntando al bundle del React-Core duplicado
    # (60309c9c) aunque lo saquemos del project. Redirigimos al bundle real.
    support = File.join(__dir__, 'Pods/Target Support Files/Pods-thegoodtrainer')
    broken = 'React-Core-60309c9c/AccessibilityResources.bundle'
    fixed = 'React-Core/AccessibilityResources.bundle'
    Dir.glob(File.join(support, 'Pods-thegoodtrainer-resources*')).each do |path|
      next unless File.file?(path)
      contents = File.read(path)
      next unless contents.include?(broken)
      File.write(path, contents.gsub(broken, fixed))
    end
  end

  # CocoaPods a veces no deja [CP] Embed Pods Frameworks (Hermes).
  # post_integrate corre DESPUÉS de integrar el user project.
  post_integrate do |installer|
    project_path = File.join(__dir__, 'thegoodtrainer.xcodeproj')
    project = Xcodeproj::Project.open(project_path)
    target = project.targets.find { |t| t.name == 'thegoodtrainer' }
    next unless target

    unless target.shell_script_build_phases.any? { |p| p.name == '[CP] Embed Pods Frameworks' }
      phase = target.new_shell_script_build_phase('[CP] Embed Pods Frameworks')
      phase.shell_script = '"${PODS_ROOT}/Target Support Files/Pods-thegoodtrainer/Pods-thegoodtrainer-frameworks.sh"' + "\n"
      phase.input_file_list_paths = [
        '${PODS_ROOT}/Target Support Files/Pods-thegoodtrainer/Pods-thegoodtrainer-frameworks-${CONFIGURATION}-input-files.xcfilelist'
      ]
      phase.output_file_list_paths = [
        '${PODS_ROOT}/Target Support Files/Pods-thegoodtrainer/Pods-thegoodtrainer-frameworks-${CONFIGURATION}-output-files.xcfilelist'
      ]
      project.save
    end
  end
end
